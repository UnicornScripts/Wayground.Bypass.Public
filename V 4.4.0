    strokes: [
      'M8.70735 16.1385C8.68871 16.0723 8.73736 16.006 8.80673 16.006H10.0004C10.0625 16.006 10.1111 15.9512 10.1028 15.89L9.92787 14.4821C9.92164 14.4304 9.87718 14.391 9.82535 14.391H4.25692C4.18135 14.391 4.13166 14.4687 4.16271 14.537L8.44854 24.0217C8.4651 24.059 8.50238 24.0827 8.54275 24.0827H10.9352C10.9693 24.0827 10.9942 24.0497 10.9848 24.0166L8.70735 16.1385Z',
