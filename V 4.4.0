    ]
  };

  // Settings navigation. Every entry is backed by real, persisted settings;
  // nothing here is a placeholder for a feature that does not exist.
  const SETTINGS = [
    ['ai', 'AI'],
    ['behavior', 'Behavior'],
    ['look', 'Look'],
    ['advanced', 'Advanced'],
    ['about', 'About']
  ];

  const ui = (() => {
    let host = null, shadow = null, win = null, bar = null, pill = null, dot = null, bgLayer = null, autoBtn = null;
    let statusEl = null, liveEl = null, setEl = null, setNavEl = null, setBodyEl = null;
    let refs = {}, raf = 0, uidc = 0, liveDrawn = null;
    const kinds = new Set();

    // One icon family: 24x24, round joins, 1.8 stroke. No mixed styles.
    const ICONS = {
      gear: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-1.8-.3 1.6 1.6 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.6 1.6 0 0 0-1-1.5 1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0 .3-1.8 1.6 1.6 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.6 1.6 0 0 0 1.5-1 1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3H9a1.6 1.6 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.6 1.6 0 0 0 1 1.5 1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V9a1.6 1.6 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1z',
      close: 'M18 6L6 18M6 6l12 12',
      minimize: 'M5 12h14',
      bolt: 'M13 2L4.5 13.5H12l-1 8.5L19.5 10H12z',
      back: 'M19 12H5M11 6l-6 6 6 6',
      refresh: 'M21 12a9 9 0 1 1-3-6.7M21 4v5h-5',
      image: 'M3 5h18v14H3zM3 15l5-5 4 4 3-3 6 6',
      play: 'M6 4l14 8-14 8z',
      stop: 'M6 6h12v12H6z',
      search: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-4.5-4.5',
      warn: 'M12 3l9 16H3zM12 9v5M12 17h.01'
    };
    const SVG_NS = 'http://www.w3.org/2000/svg';
    const svgRoot = (attrs) => {
      const s = document.createElementNS(SVG_NS, 'svg');
      for (const k of Object.keys(attrs)) s.setAttribute(k, attrs[k]);
      s.setAttribute('aria-hidden', 'true');
      s.setAttribute('focusable', 'false');
      return s;
    };
    function icon(name) {
      const s = svgRoot({ viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor',
        'stroke-width': '1.8', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' });
      const p = document.createElementNS(SVG_NS, 'path');
      p.setAttribute('d', ICONS[name] || ICONS.warn);
      s.append(p);
      return s;
    }
    // The official Wayground logotype (mark + wordmark), drawn from the brand
    // asset's own path data. It is monochrome magenta, exactly as served.
    function wgLogotype() {
      const s = svgRoot({ viewBox: '0 0 180 23', class: 'logotype', fill: WG_LOGOTYPE_FILL,
        role: 'img' });
      s.setAttribute('aria-label', 'Wayground');
      for (const d of WG_LOGOTYPE) {
        const p = document.createElementNS(SVG_NS, 'path');
        p.setAttribute('d', d);
        p.setAttribute('fill', WG_LOGOTYPE_FILL);
        s.append(p);
      }
      return s;
    }
    // The official square mark on its blackberry plate, used where the full
    // wordmark has no room. plate=false drops the background for light headers.
    function wgMark(size, plate) {
      const s = svgRoot({ viewBox: WG_MARK.viewBox, width: String(size), height: String(size),
        fill: 'none' });
      if (plate !== false) {
        const bg = document.createElementNS(SVG_NS, 'rect');
        bg.setAttribute('width', '32'); bg.setAttribute('height', '32');
        bg.setAttribute('rx', String(WG_MARK.radius));
        bg.setAttribute('fill', WG_MARK.plateFill);
        s.append(bg);
      }
      for (const d of WG_MARK.strokes) {
        const p = document.createElementNS(SVG_NS, 'path');
        p.setAttribute('d', d);
        p.setAttribute('fill', '#FF319F');
        s.append(p);
      }
      return s;
    }
    function brand(compact) {
      return h('span', { class: 'brand' },
        compact ? wgMark(24, false) : wgLogotype());
    }

    function h(tag, props, ...kids) {
      const el = document.createElement(tag);
      for (const [k, v] of Object.entries(props || {})) {
        if (v == null || v === false) continue;
        if (k === 'class') el.className = v;
        else if (k === 'text') el.textContent = v;
        else if (k.startsWith('on')) el.addEventListener(k.slice(2), v);
        else if (k === 'checked' || k === 'value' || k === 'disabled') el[k] = v;
        else el.setAttribute(k, v === true ? '' : v);
      }
      for (const kid of kids.flat()) {
        if (kid == null || kid === false) continue;
        el.append(kid.nodeType ? kid : document.createTextNode(String(kid)));
      }
      return el;
    }
    const btn = (label, fn, kind, iconName) => h('button', { type: 'button', class: 'btn ' + (kind || ''), onclick: fn },
      iconName ? icon(iconName) : null, h('span', { text: label }));
    const row = (label, ctl, hint) => {
      const id = 'c' + (++uidc);
      ctl.id = id;
      return h('div', { class: 'row' }, h('label', { for: id }, label, hint ? h('small', { class: 'muted', text: hint }) : null), ctl);
    };
    const group = (title, ...kids) => h('section', { class: 'group' }, h('div', { class: 'row' },
      h('label', {}, h('b', { text: title }))), kids.flat());
    const note = (tone, text) => h('p', { class: 'note ' + (tone || '') }, text);
    const eyebrow = (text) => h('div', { class: 'eyebrow' }, h('span', { text }));
    const changed = (after) => { saveSettings(); applyAppearance(); layout(); if (after) after(); };
    const sw = (path, label, hint, after) => {
      const i = h('input', { type: 'checkbox', class: 'sw', role: 'switch', checked: !!getPath(path) });
      i.addEventListener('change', () => { setPath(path, i.checked); changed(after); });
      return row(label, i, hint);
    };
    const slider = (path, label, min, max, step, fmt, after) => {
      const out = h('small', { class: 'muted', text: fmt(getPath(path)) });
      const i = h('input', { type: 'range', min, max, step, value: String(getPath(path)) });
      i.addEventListener('input', () => { setPath(path, Number(i.value)); out.textContent = fmt(getPath(path)); changed(after); });
      const r = row(label, i);
      r.firstChild.append(out);
      return r;
    };
    const colorInput = (path, label, after) => {
      const i = h('input', { type: 'color', value: getPath(path) });
      i.addEventListener('input', () => { setPath(path, i.value); changed(after); });
      return row(label, i);
    };
    const field = (path, label, opts) => {
      const o = opts || {};
      const i = h('input', { type: o.type || 'text', value: String(getPath(path) || ''), placeholder: o.placeholder || '', autocomplete: 'off', spellcheck: 'false' });
      i.addEventListener('change', () => {
        setPath(path, o.type === 'number' ? Number(i.value) : i.value.trim());
        i.value = String(getPath(path) || '');
        changed(o.after);
      });
      return row(label, i, o.hint);
    };
    const select = (path, label, options, after) => {
      const s = h('select', {}, options.map(([v, t]) => h('option', { value: v, text: t })));
      s.value = String(getPath(path));
      s.addEventListener('change', () => { setPath(path, s.value); changed(after); });
      return row(label, s);
    };
    const PROVIDER_CHOICES = [['', 'None'], ['openrouter', 'OpenRouter'], ['gemini', 'Google AI Studio'], ['groq', 'Groq'], ['huggingface', 'Hugging Face']];
    // A provider select that also moves the model with it. Leaving a model id
    // from the previous provider in place guarantees the next description
    // request fails with a 404 that looks like a broken key.
    const providerSelect = (label, providerPath, modelPath, after) => {
      const el = h('select', {}, PROVIDER_CHOICES.map(([v, t]) => h('option', { value: v, text: t })));
      el.value = String(getPath(providerPath) || '');
      el.addEventListener('change', () => {
        const next = el.value;
        const previous = String(getPath(providerPath) || '');
        setPath(providerPath, next);
        if (next !== previous) setPath(modelPath, VISION_DEFAULT_MODEL[next] || '');
        changed(after);
      });
      return row(label, el);
    };
    const kv = (pairs) => h('dl', { class: 'kv' }, pairs.flatMap(([k, v]) => [h('dt', { text: k }), h('dd', { text: String(v == null ? '' : v) })]));
    const chip = (tone, text) => h('span', { class: 'chip ' + tone, text });
    // White or black text, whichever is readable on the given background.
    const readableOn = (hex) => {
      const m = /^#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i.exec(String(hex || ''));
      if (!m) return '#fff';
      const lin = (h8) => { const c = parseInt(h8, 16) / 255; return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4); };
      const L = 0.2126 * lin(m[1]) + 0.7152 * lin(m[2]) + 0.0722 * lin(m[3]);
      // White wins while (L + 0.05)^2 <= 1.05 * 0.05, i.e. L <= 0.179.
      return L <= 0.179 ? '#fff' : '#1b1b1b';
    };

    /* ---------- appearance ---------- */
    function prefersDark() {
      try { return !window.matchMedia || window.matchMedia('(prefers-color-scheme: dark)').matches; } catch (e) { return true; }
    }
    function applyAppearance() {
      if (!win) return;
      const ap = settings.appearance;
      const theme = ap.theme === 'system' ? (prefersDark() ? 'dark' : 'light') : ap.theme;
      win.dataset.theme = theme;
      win.dataset.anim = (ap.animations && !ap.reducedMotion && !prefersReducedMotion()) ? 'on' : 'off';
      win.dataset.density = ap.compact ? 'compact' : 'normal';
      const s = win.style;
      s.setProperty('--op', String(ap.opacity));
      s.setProperty('--fs', String(ap.fontSize));
      s.setProperty('--scale', String(ap.scale || 1));
      s.setProperty('--bg-op', String(ap.bgOpacity != null ? ap.bgOpacity : 0.3));
      s.setProperty('--bg-blur', String(ap.bgBlur || 0));
      s.setProperty('--bg-overlay', String(ap.bgOverlay != null ? ap.bgOverlay : 0.88));
      // A custom accent only replaces the accent; the Wayground ink, paper and
      // state colours stay, so the interface keeps its brand identity.
      if (ap.accent && ap.accent.toLowerCase() !== '#ff319f') {
        s.setProperty('--accent', ap.accent);
        s.setProperty('--ring', ap.accent);
      } else {
        s.removeProperty('--accent');
        s.removeProperty('--ring');
      }
      const hasImg = ap.bgImage && typeof ap.bgImage === 'string' && ap.bgImage.trim();
      const validUrl = hasImg && /^(https?:\/\/|data:image\/)/i.test(ap.bgImage.trim());
      win.dataset.hasBg = validUrl ? '1' : '0';
      if (bgLayer) {
        bgLayer.style.backgroundImage = validUrl ? 'url(' + JSON.stringify(ap.bgImage.trim()) + ')' : 'none';
      }
    }
    function prefersReducedMotion() {
      try { return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches); } catch (e) { return false; }
    }
    const ap_x = () => (Number.isFinite(Number(settings.appearance.panelX)) ? Number(settings.appearance.panelX) : -1);
    const ap_y = () => (Number.isFinite(Number(settings.appearance.panelY)) ? Number(settings.appearance.panelY) : 72);
    // panelW / panelH are real now: the user can size the panel within a range
    // that keeps every control reachable.
    const ap_w = () => Math.round(clamp(Number(settings.appearance.panelW) || PANEL_W, 300, 560, PANEL_W));
    const ap_h = () => Math.round(clamp(Number(settings.appearance.panelH) || PANEL_H, 340, 760, PANEL_H));
    let brandEl = null;
    function drawBrand(narrow) {
      if (!brandEl) return;
      brandEl.replaceChildren(narrow ? wgMark(24, false) : wgLogotype());
      brandEl.setAttribute('title', narrow ? 'Wayground Study Assistant' : '');
    }
    function layout() {
      if (!win) return;
      const vw = window.innerWidth, vh = window.innerHeight, m = 8;
      pill.style.display = minimized ? 'grid' : 'none';
      win.style.display = minimized ? 'none' : 'flex';
      if (minimized) return;
      const s = win.style;
      const scale = Number(settings.appearance.scale) || 1;
      const w = Math.max(240, Math.min(ap_w(), vw - 2 * m));
      const hh = Math.max(240, Math.min(ap_h(), vh - 2 * m));
      let x = ap_x(), y = ap_y();
      if (x < 0) {
        if (settings.appearance.position === 'left') x = 16;
        else if (settings.appearance.position === 'center') { x = Math.round((vw - w * scale) / 2); y = Math.round((vh - hh * scale) / 2); }
        else x = vw - Math.round(w * scale) - 16;
      }
      const maxX = Math.max(m, vw - Math.round(w * scale) - m), maxY = Math.max(m, vh - Math.round(hh * scale) - m);
      x = Math.min(Math.max(m, x), maxX);
      y = Math.min(Math.max(m, y), maxY);
      s.left = x + 'px'; s.top = y + 'px'; s.width = w + 'px'; s.height = hh + 'px';
      // Below this width the wordmark would push the header controls out.
      drawBrand(w < 316);
    }

    /* ---------- live screen ---------- */
    // One status line instead of five metric tiles. The labels stay short
    // because the header has to keep the four controls reachable.
    const LIVE_STATES = {
      IDLE: ['Idle', 'idle'],
      LOBBY: ['Lobby', 'idle'],
      QUESTION_LOADING: ['Scanning', 'loading'],
      QUESTION_READY: ['Ready', 'idle'],
      ANALYZING: ['Asking', 'loading'],
      RESULT_READY: ['Answered', 'done'],
      ERROR: ['Check', 'error']
    };
    let statusLabel = null;
    function drawChrome() {
      const st = LIVE_STATES[S.app.state] || LIVE_STATES.IDLE;
      if (dot) dot.dataset.s = st[1];
      if (statusLabel) statusLabel.textContent = st[0];
      if (pill) pill.dataset.s = st[1];
    }

    function drawQuestion() {
      const box = refs.qbox;
      if (!box) return;
      box.replaceChildren();
      const d = S.detect;
      const images = (S.detectRuntime && S.detectRuntime.images) || d.images || [];
      const choices = (S.edit.choices ? S.edit.choices.split('\n').filter((t) => t.trim()) : d.choices) || [];
      const question = S.edit.question || d.question || '';
      if (!question && !choices.length) {
        box.append(h('div', { class: 'promptbox' },
          eyebrow(d.ok ? 'Question' : 'No question yet'),
          h('p', { class: 'muted', text: d.reason || 'Open a Wayground question, or type one below.' })));
        return;
      }
      const a = S.analysis;
      const winner = a.status === 'done' && a.result && a.result.choice ? a.result.choice : '';
      const pb = h('div', { class: 'promptbox' },
        eyebrow(d.ok ? ('Question \u00B7 ' + d.choices.length + ' options') : 'Question (typed)'),
        h('p', { class: 'qtext', text: question }));
      if (choices.length) {
        pb.append(h('ul', { class: 'opts' }, choices.map((t, i) => {
          const label = labelFor(i);
          return h('li', { class: 'opt' + (winner ? (label === winner ? ' best' : ' off') : '') },
            h('span', { class: 'ol', text: label }), h('span', { class: 'ot', text: t }));
        })));
      }
      if (images.length) {
        pb.append(h('div', { class: 'chips' }, images.map((im) => chip(im.available ? 'vote' : 'mute',
          (im.role === 'option' && Number.isInteger(im.optionIndex) ? 'Option ' + labelFor(im.optionIndex) : 'Question') +
          (im.caption ? ': ' + trunc(im.caption, 34) : im.available ? ' image ready' : ' image not read')))));
      }
      // Trigger A: dictation runs only when this button is pressed.
      if (images.some(isRelevantImage)) {
        const st = S.dictation;
        const running = st.status === 'running';
        pb.append(h('div', { class: 'btns mt' },
          btn(running ? 'Describing\u2026' : 'Describe Image', () => {
            if (S.dictation.status === 'running') return;
            describeImage({ trigger: 'manual', sig: S.detect.sig });
          }, 'ghost', 'image')));
        if (running) {
          pb.append(h('p', { class: 'note', text: 'Asking ' + st.model + ' to describe the image\u2026' }));
        } else if (st.status === 'done' && st.text) {
          pb.append(h('div', { class: 'dict mt' },
            h('div', { class: 'k', text: 'Image description \u00B7 ' + (st.trigger === 'recovery' ? 'answer recovery' : 'manual') }),
            h('p', { class: 'dict-text', text: st.text })));
        } else if (st.status === 'error' && st.error) {
          pb.append(note('bad', 'Dictation failed: ' + st.error));
        }
      }
      box.append(pb);
    }

    function drawAnswer() {
      const box = refs.res;
      if (!box) return;
      box.replaceChildren();
      const a = S.analysis, ver = a.verification;

      if (a.status === 'loading') {
        box.append(h('div', { class: 'answer', 'data-tone': 'warn' },
          h('div', { class: 'eyebrow' }, h('span', { text: 'Working' })),
          h('div', { class: 'skel w2' }), h('div', { class: 'skel w1' }), h('div', { class: 'skel w3' }),
          h('div', { class: 'ameta', text: 'Asking ' + (S.app.model || 'the configured model') + '. Every reply is validated before it counts.' })));
        return;
      }
      if (a.status === 'error') {
        box.append(h('div', { class: 'answer', 'data-tone': 'bad' },
          h('div', { class: 'eyebrow' }, h('span', { text: 'No answer' })),
          h('p', { text: safeText(a.error.message) }),
          a.error.remediation ? note('', a.error.remediation) : null,
          // An internal code string is not actionable. What a user can act on
          // is the kind of failure, the status if there was one, and whether
          // trying again is even worth it.
          h('div', {
            class: 'ameta',
            text: 'Failure kind: ' + (a.error.category || 'unspecified') +
              (a.error.status ? ' (HTTP ' + a.error.status + ')' : '') + ' - ' +
              (a.error.retryable ? 'retrying may help' : 'retrying will not help')
          })));
        return;
      }
      if (a.status === 'idle') {
        box.append(note('', S.detect.ok ? 'Press Analyze when you want the answer.' : (S.detect.reason || 'No analysis yet.')));
        return;
      }

      const r = a.result;
      // A single-model run has nothing to cross-check, so it is never labelled
      // "verified" just because a threshold of one was met.
      const single = a.mode === 'single';
      const tone = single ? '' : (ver && ver.state === 'verified') ? 'ok' : (ver && ver.state === 'conflicting') ? 'warn' : '';
      const head = h('div', { class: 'answer', 'data-tone': tone },
        h('div', { class: 'eyebrow' }, h('span', { text: (single ? 'Suggested answer' : (VERIFICATION_LABELS[(ver && ver.state) || 'none'] || 'Answer')).toUpperCase() })));
      if (ver && ver.state === 'conflicting') {
        head.append(h('p', { text: 'The models disagree: ' + ver.ranked.join(' vs ') + '. No answer is offered.' }));
      } else if (r && r.choice) {
        head.append(h('div', { class: 'aline' },
          h('span', { class: 'aletter', text: r.choice }),
          h('span', { class: 'atext', text: r.text }),
          r.confidence ? h('span', { class: 'badge ' + r.confidence, text: r.confidence }) : null));
        if (r.explanation) head.append(h('p', { class: 'aexpl', text: r.explanation }));
      } else if (a.info && a.info.message) {
        head.append(h('p', { text: a.info.message }));
      }
      const bits = [];
      if (!single && ver) bits.push(ver.topCount + ' of ' + ver.validCount + ' agree');
      if (a.dictation) bits.push('image dictation used');
      if (a.fromCache) bits.push('from cache');
      if (a.highlight) bits.push(a.highlight);
      head.append(h('div', { class: 'ameta', text: bits.join(' \u00B7 ') || 'Agreement is consistency, not proof of correctness.' }));
      box.append(head);

      // Detail that only matters when something is wrong stays folded away.
      const detail = [];
      if (a.breakdown && a.breakdown.length) {
        for (const x of a.breakdown) {
          detail.push(h('div', { class: 'bd-row' },
            h('div', { class: 'bd-main' }, h('b', { text: PROVIDER_META[x.provider] ? PROVIDER_META[x.provider].label : x.provider }), h('small', { class: 'muted', text: x.model || 'no model' })),
            x.choice ? h('span', { class: 'letter' + (ver && ver.top === x.choice ? ' best' : ''), text: x.choice }) : null,
            x.ok ? chip(x.uncertain ? 'abstain' : 'vote', x.uncertain ? 'uncertain' : x.confidence || 'valid') : chip('fail', x.category || 'failed'),
            h('small', { class: 'muted num', text: x.latencyMs != null ? x.latencyMs + ' ms' : '' }),
            x.httpStatus ? h('small', { class: 'muted num', text: 'HTTP ' + x.httpStatus }) : null,
            x.error ? h('small', { class: 'bd-msg', text: x.error }) : null));
        }
      }
      for (const u of (a.usage || [])) {
        detail.push(h('div', { class: 'bd-row' },
          h('div', { class: 'bd-main' }, h('b', { text: PROVIDER_META[u.provider].label }), h('small', { class: 'muted', text: u.model })),
          h('small', { class: 'muted', text: u.cost.known ? u.cost.text : u.cost.promptTokens + ' in / ' + u.cost.completionTokens + ' out tokens' })));
      }
      if (detail.length) {
        box.append(h('details', { class: 'h' }, h('summary', { text: 'Model detail (' + a.breakdown.length + ')' }), detail));
      }
      if (S.lastSelection && S.lastSelection.state !== 'acted') {
        const sel = S.lastSelection;
        box.append(h('div', { class: 'card ' + (sel.state === 'failed' || sel.state === 'refused' ? 'warn' : '') },
          h('b', { text: 'Answer selection' }),
          h('p', { text: sel.state === 'confirm' ? 'Ready to select ' + sel.letter + '. ' + sel.text : (sel.reason || sel.state) }),
          sel.state === 'confirm' ? h('div', { class: 'btns mt' },
            btn('Select now', () => {
              const d = detectNow();
              const el = d.ok ? d.cEls[sel.index] : null;
              if (!el) { S.lastSelection = { state: 'refused', reason: 'The option is no longer on the page.' }; ui.refresh('analysis'); return; }
              autoSelect.act(el.querySelector('button,[role="button"],input') || el);
            }, 'primary'),
            btn('Cancel', () => { S.lastSelection = null; ui.refresh('analysis'); }, 'ghost'),
            h('small', { class: 'muted', text: 'Or click the option yourself.' })) : null));
      }
    }

    function viewTargets() {
      const card = h('div', { class: 'card' }, h('b', { text: 'Models that will answer' }));
      const plan = plannedTargets();
      const vOn = settings.verification.enabled;
      // Every enabled provider stays configurable here; only the ones that will
      // actually be asked are flagged.
      const rows = vOn
        ? plan.targets
        : PROVIDER_IDS
          .filter((p) => settings.providers[p].enabled)
          .map((p) => ({ provider: p, model: modelPlan(p).plan[0] || '' }));
      if (!rows.length) {
        card.append(h('small', { class: 'muted', text: 'No provider is enabled. Open AI Providers to add a key and enable a provider.' }));
        return card;
      }
      const answering = plan.targets[0] ? plan.targets[0].provider : '';
      rows.forEach((t) => {
        const pSel = h('select', {}, PROVIDER_IDS.map((p) => h('option', { value: p, text: PROVIDER_META[p].label })));
        pSel.value = t.provider;
        pSel.addEventListener('change', () => {
          if (vOn) {
            const entry = settings.verification.models.find((m) => m.provider === t.provider);
            if (entry) entry.model = '';
          } else {
            setPath('providers.' + t.provider + '.modelMode', 'auto');
          }
          changed(() => ui.rerender());
        });
        const ids = modelStore[t.provider].ids.slice(0, 400);
        const mSel = h('select', {}, [h('option', { value: '', text: 'Automatic (provider default)' })].concat(ids.map((id) => h('option', { value: id, text: id }))));
        mSel.value = t.model;
        mSel.addEventListener('change', () => {
          if (vOn) {
            const entry = settings.verification.models.find((m) => m.provider === t.provider);
            if (entry) entry.model = mSel.value;
          } else {
            setPath('providers.' + t.provider + '.modelMode', mSel.value ? 'manual' : 'auto');
            setPath('providers.' + t.provider + '.manualModel', mSel.value);
          }
          changed(() => ui.rerender());
        });
        const tag = !vOn ? chip(t.provider === answering ? 'vote' : 'mute', t.provider === answering ? 'answers' : 'standby') : null;
        // Provider name and its two selectors stack: side by side they were
        // unreadable in a 340 px panel.
        card.append(h('div', { class: 'prow' },
          h('div', { class: 'prow-top' }, h('b', { text: PROVIDER_META[t.provider].label }), tag),
          h('div', { class: 'prow-sel' }, pSel, mSel)));
      });
      card.append(h('small', { class: 'muted', text: vOn
        ? 'Verification mode: every model listed above is queried and the answers are compared.'
        : 'Single-answer mode: only the provider marked "answers" is queried, so one question costs one request. The others stay on standby and are used only by an explicit failover (Automation \u2192 Allow failover to another provider). Enable verification mode to compare specific models.' }));
      return card;
    }

    /* ---------- the pipeline component ---------- */
    // A step list, not a progress bar: none of these APIs report a percentage,
    // so anything that looked like one would be decoration.
    function drawPipeline() {
      const box = refs.pipe;
      if (!box) return;
      box.replaceChildren();
      const p = S.pipe;
      const running = PIPE_STAGES.some((k) => p.stages[k].state === 'active');
      if (!p.startedAt || (p.stages.detecting.state === 'pending' && !running)) {
        box.append(note('', 'No image work on this question yet.'));
        return;
      }
      // Named as the description model on purpose: the provider that answers
      // the question is shown with the answer, and the two are often not the
      // same model. Without the label the two lines look like a contradiction.
      const who = p.provider
        ? 'description model: ' + (PROVIDER_META[p.provider] ? PROVIDER_META[p.provider].label : p.provider) + ' · ' + (p.model || 'no model')
        : 'no description provider selected';
      const card = h('section', { class: 'pipe', 'aria-label': 'Image processing pipeline' },
        h('div', { class: 'pipe-head' },
          h('div', { class: 'k', text: 'Image processing' }),
          chip(p.error ? 'fail' : (p.stages.completed.state === 'done' ? 'vote' : running ? 'abstain' : 'mute'),
            pipeSummary(p))),
        h('div', { class: 'pipe-who', text: (p.route || 'not decided') + ' · ' + who +
          (p.captureMethod && p.captureMethod !== 'none' ? ' · source: ' + p.captureMethod : '') +
          (p.trigger ? ' · ' + (p.trigger === 'recovery' ? 'answer recovery' : p.trigger === 'analysis' ? 'analysis' : 'manual request') : '') }));
      const list = h('ul', { class: 'steps' });
      for (const k of PIPE_STAGES) {
        const st = p.stages[k];
        list.append(h('li', { class: 'step', 'data-s': st.state },
          h('span', { class: 'mk' }),
          h('span', { class: 'nm' }, PIPE_LABELS[k], st.detail ? h('span', { class: 'sd', text: st.detail }) : null),
          st.ms ? h('span', { class: 'tm num', text: st.ms >= 1000 ? (Math.round(st.ms / 100) / 10) + 's' : st.ms + ' ms' })
            : st.state === 'skipped' ? h('span', { class: 'tm', text: 'skipped' }) : null));
      }
      card.append(list);
      if (p.caption) {
        card.append(h('details', { class: 'h mt' },
          h('summary', { text: p.reused ? 'Description (reused, unchanged image)' : 'Description' }),
          h('p', { class: 'dict-text', text: p.caption })));
      }
      if (p.error) {
        card.append(note('bad', safeText(p.error.message)));
      }
      const acts = [];
      if (p.error || p.stages.completed.state === 'done') {
        acts.push(btn('Retry', () => {
          scanNow();
          describeImage({ trigger: 'manual', sig: S.detect.sig });
        }, 'ghost', 'refresh'));
      }
      if (acts.length) card.append(h('div', { class: 'pipe-actions' }, acts));
      const tech = [];
      const scan = (S.detect && S.detect.diag && S.detect.diag.imageScan) || null;
      if (p.imageUrls && p.imageUrls.length) {
        tech.push('Pictures chosen:');
        for (const n of p.imageNotes) tech.push('  ' + n);
        for (const u of p.imageUrls) tech.push('  ' + u);
      }
      if (scan) {
        tech.push('Scan: ' + scan.scopes + ' group(s), ' + scan.hops + ' ancestor level(s), ' +
          scan.scanned + ' candidate(s), ' + scan.kept + ' kept' +
          (scan.backgroundPass ? ', CSS backgrounds checked' : '') + ' - ' + (scan.region || 'no stop'));
        for (const r of scan.rejected.slice(0, 4)) tech.push('  ignored ' + trunc(safeText(r.src), 110) + ': ' + r.why);
        for (const r of scan.overflow.slice(0, 2)) tech.push('  over the limit: ' + r.src);
      }
      if (p.attempts && p.attempts.length) {
        tech.push('Provider attempts:');
        for (const a of p.attempts) {
          tech.push('  ' + (a.provider || '?') + ' / ' + (a.model || '?') + ': ' +
            (a.ok ? 'succeeded' : 'failed (' + (a.category || 'unknown') + ') ' + trunc(safeText(a.error || ''), 120)));
        }
        const winner = p.attempts.filter((a) => a.ok).pop();
        tech.push(winner ? 'Described by ' + winner.provider + ' after ' + p.attempts.length + ' attempt(s)'
          : 'No provider succeeded in ' + p.attempts.length + ' attempt(s)');
      }
      if (p.notes && p.notes.length) tech.push('Notes: ' + p.notes.join('; '));
      if (p.images) tech.push('Images on card: ' + p.images);
      if (p.captureMethod) tech.push('Source: ' + p.captureMethod);
      if (p.sig) tech.push('Question signature: ' + String(p.sig).slice(0, 12));
      if (p.startedAt) tech.push('Started: ' + new Date(p.startedAt).toLocaleTimeString());
      card.append(h('details', { class: 'tech' }, h('summary', { text: 'Technical details' }),
        h('pre', { text: tech.length ? tech.join('\n') : 'No request-level detail yet.' })));
      box.append(card);
    }

    /* ---------- the live panel ---------- */
    function screenLive() {
      const q = h('textarea', { rows: 3, value: S.edit.question, placeholder: 'Paste the question if detection fails', 'aria-label': 'Question text' });
      const c = h('textarea', { rows: 4, value: S.edit.choices, placeholder: 'One answer option per line', 'aria-label': 'Answer options' });
      const n = h('textarea', { rows: 2, value: S.edit.notes, placeholder: 'Optional study notes', 'aria-label': 'Study notes' });
      q.addEventListener('input', () => { S.edit.question = q.value; S.edit.dirty = true; });
      c.addEventListener('input', () => { S.edit.choices = c.value; S.edit.dirty = true; });
      n.addEventListener('input', () => { S.edit.notes = n.value; });
      const lab = (t, el) => h('div', {}, h('div', { class: 'k', text: t }), el);
      refs = { q, c, n, qbox: h('div'), res: h('div', { class: 'stack', role: 'status', 'aria-live': 'polite' }), pipe: h('div'), foot: h('div', { class: 'ameta' }) };

      const editor = h('details', { class: 'h' },
        h('summary', { text: 'Fix the detected text' }),
        lab('Question', q), lab('Answer options', c), lab('Study notes', n),
        h('div', { class: 'btns mt' },
          btn('Reset to detected', () => {
            if (!S.detect.ok) return;
            S.edit.question = S.detect.question;
            S.edit.choices = S.detect.choices.join('\n');
            S.edit.dirty = false;
            syncInputs();
          }, 'ghost')));

      const actions = h('div', { class: 'actions' },
        btn('Analyze', () => runAnalysis(false), 'primary', 'play'),
        btn('Cancel', () => { cancelAnalysis(); ui.refresh('analysis'); }, 'ghost', 'stop'),
        btn('Detect', scanNow, 'ghost', 'search'));

      drawQuestion();
      drawAnswer();
      drawPipeline();
      drawFooter();
      return h('div', { class: 'scroller' },
        settings.acknowledged ? null : ackCard(),
        refs.qbox,
        refs.res,
        actions,
        refs.pipe,
        refs.foot,
        editor);
    }

    // One dense line instead of a wall of status tiles.
    function drawFooter() {
      if (!refs.foot) return;
      const a = S.analysis;
      const parts = [];
      if (a.status === 'done') {
        const who = (a.info && a.info.model) || S.app.model;
        if (who) parts.push(who);
        if (S.app.durationMs) parts.push(S.app.durationMs + ' ms');
      }
      if (autoSelect.enabled()) parts.push('auto-click on');
      if (settings.verification.enabled) parts.push('verification on');
      refs.foot.replaceChildren();
      if (!parts.length) return;
      refs.foot.append(h('small', { class: 'muted', text: parts.join(' \u00B7 ') }));
      if (autoSelect.enabled()) {
        refs.foot.append(' ');
        refs.foot.append(btn('Stop clicking', () => autoSelect.stop('stopped from the panel'), 'ghost'));
      }
    }

    function ackCard() {
      const cb = h('input', { type: 'checkbox' });
      return h('div', { class: 'card warn' },
        h('b', { text: 'Before you start' }),
        h('p', { text: 'Use this for practice, review or study where AI help is allowed. Do not use it in live graded games. Automatic answer selection is off by default and needs explicit activation. Model agreement is consistency, not a verified answer key.' }),
        h('label', { class: 'chk' }, cb, 'I will only use it where AI assistance is allowed.'),
        btn('Continue', () => {
          if (!cb.checked) { cb.focus(); return; }
          settings.acknowledged = true;
          saveSettings();
          renderTab();
        }, 'primary'));
    }

    function syncInputs() {
      if (refs.q) { refs.q.value = S.edit.question; refs.c.value = S.edit.choices; }
    }

    /* ---------- providers ---------- */
    // Every key that reaches storage from here has been typed or pasted into
    // the assistant's own panel by a person, which is what makes it manual. A
    // cross-provider key needs a second, explicit yes because saving it would
    // disclose the credential to a service that never issued it.
    function commitNewKey(pid, raw) {
      const label = 'Key ' + (keyStore.pool(pid).length + 1);
      let res = keyStore.add(pid, raw, label, { source: 'manual' });
      if (!res.ok && res.code === 'provider-mismatch' && settings.security.confirmCrossProviderKeys) {
        if (confirm(res.error + String.fromCharCode(10) + 'Save it under this provider anyway? A key saved to the wrong provider is sent to that provider.')) {
          res = keyStore.add(pid, raw, label, { source: 'manual', confirmedMismatch: true });
        }
      }
      return res;
    }

    function keyList(pid) {
      const list = keyStore.pool(pid);
      const box = h('div', { class: 'stack' });
      if (!list.length) box.append(h('small', { class: 'muted', text: 'No keys stored for this provider yet.' }));
      list.forEach((k) => {
        const state = k.status && k.status !== 'unknown' ? k.status
          : (!k.enabled ? 'disabled' : k.invalid ? 'invalid' : k.cooldownUntil > nowMs() ? 'rate-limited' : 'unknown');
        const tone = { connected: 'vote', checking: 'abstain', invalid: 'fail', 'rate-limited': 'abstain', error: 'fail', unknown: 'mute', disabled: 'mute' }[state] || 'mute';
        const label = state === 'unknown'
          ? (k.enabled ? (k.invalid ? 'Invalid key' : 'Not checked') : 'Disabled')
          : keyStatusLabel(state);
        const modelIn = h('input', { type: 'text', value: k.model || '', placeholder: 'model override (optional)', 'aria-label': 'Model override for ' + k.label });
        modelIn.addEventListener('change', () => { keyStore.update(pid, k.id, { model: modelIn.value.trim() }); ui.rerender(); });
        box.append(h('div', { class: 'bd-row' },
          h('div', { class: 'bd-main' },
            h('b', { text: k.label }),
            h('small', { class: 'muted', text: maskSecret(k.secret) + ' \u00B7 ' + label + (k.httpStatus ? ' \u00B7 HTTP ' + k.httpStatus : '') })),
          chip(tone, label),
          h('div', { class: 'btns' },
            btn('Validate', () => validateKey(pid, k.id, true).then(() => ui.rerender())),
            btn(k.enabled ? 'Disable' : 'Enable', () => { keyStore.update(pid, k.id, { enabled: !k.enabled }); ui.rerender(); }),
            btn('\u2191', () => { keyStore.reorder(pid, k.id, -1); ui.rerender(); }),
            btn('\u2193', () => { keyStore.reorder(pid, k.id, 1); ui.rerender(); }),
            btn('Remove', () => { if (confirm('Remove key "' + k.label + '"?')) { keyStore.remove(pid, k.id); ui.rerender(); } }, 'danger')),
          k.statusText && k.status !== 'connected' ? h('small', { class: 'bd-msg', text: k.statusText }) : null,
          h('div', { class: 'bd-row', style: 'width:100%' }, modelIn)));
      });
      return box;
    }

    function providerCard(pid) {
      const ad = adapters[pid];
      const cfg = settings.providers[pid];
      const ms = modelStore[pid];
      const plan = modelPlan(pid);
      const avail = availabilityOf(pid);
      const keyIn = h('input', { type: 'password', placeholder: 'Paste an API key', autocomplete: 'off' });
      const keyMsg = h('small', { class: 'muted', text: PROVIDER_META[pid].keyHint });
      const card = h('div', { class: 'card' },
        h('div', { class: 'row' }, h('b', { text: ad.label }), chip(keyStore.status(pid).state === 'ok' ? 'vote' : keyStore.status(pid).state === 'warn' ? 'abstain' : 'fail', keyStore.status(pid).label)),
        sw('providers.' + pid + '.enabled', 'Enabled for analysis'),
        kv([
          ['Model in use', plan.plan[0] || 'none'],
          ['Model source', plan.source],
          ['Catalog', ms.fetchedAt ? ms.ids.length + ' models, checked ' + ago(ms.verifiedAt) : 'not fetched'],
          ['Availability', avail.state + ' \u2014 ' + avail.reason],
          ['Vision capable', modelSupportsVision(pid, plan.plan[0] || '', catalogEntry(pid, plan.plan[0] || ''), null) ? 'yes' : 'not confirmed for this model'],
          ['Docs', PROVIDER_META[pid].docs]
        ]));
      card.append(h('div', { class: 'k', text: 'API keys' }), keyList(pid), row('Add key', keyIn), keyMsg,
        h('div', { class: 'btns mt' },
          btn('Add and validate', () => {
            const v = keyIn.value.trim();
            const res = commitNewKey(pid, v);
            if (!res.ok) { keyMsg.textContent = res.error; return; }
            keyIn.value = '';
            keyMsg.textContent = 'Validating\u2026';
            validateKey(pid, res.key.id, true).then((r) => {
              keyMsg.textContent = r ? (keyStatusLabel(r.status) + (r.httpStatus ? ' (HTTP ' + r.httpStatus + ')' : '') + (r.statusText ? ' \u00B7 ' + r.statusText : '')) : 'Validation did not finish.';
              ui.rerender();
            });
          }, 'primary'),
          btn('Validate all keys', () => {
            const keys = keyStore.pool(pid);
            if (!keys.length) { keyMsg.textContent = 'No keys to validate.'; return; }
            keyMsg.textContent = 'Checking\u2026';
            Promise.all(keys.map((k) => validateKey(pid, k.id, true))).then(() => { ui.rerender(); });
          }),
          btn('Refresh model catalog', () => { refreshModels(pid, true).then((r) => { keyMsg.textContent = r.ok ? 'Catalog updated (' + r.count + ' models).' : (r.message || 'Could not refresh.'); ui.rerender(); }); })));
      // Pressing Enter in the key field adds and validates the key immediately.
      keyIn.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter') return;
        e.preventDefault();
        const v = keyIn.value.trim();
        if (!v) return;
        const res = commitNewKey(pid, v);
        if (!res.ok) { keyMsg.textContent = res.error; return; }
        keyIn.value = '';
        keyMsg.textContent = 'Validating\u2026';
        validateKey(pid, res.key.id, true).then((r) => {
          keyMsg.textContent = r ? (keyStatusLabel(r.status) + (r.httpStatus ? ' (HTTP ' + r.httpStatus + ')' : '')) : 'Validation did not finish.';
          ui.rerender();
        });
      });

      const ids = ms.ids.slice(0, 400);
      const modelSel = h('select', {}, [h('option', { value: '', text: cfg.modelMode === 'auto' ? 'Automatic (from live catalog)' : 'Select a model' })].concat(ids.map((id) => h('option', { value: id, text: id }))));
      modelSel.value = cfg.modelMode === 'manual' ? cfg.manualModel : '';
      modelSel.addEventListener('change', () => {
        setPath('providers.' + pid + '.modelMode', modelSel.value ? 'manual' : 'auto');
        setPath('providers.' + pid + '.manualModel', modelSel.value);
        changed(() => ui.rerender());
      });
      card.append(
        row('Model', modelSel, 'The catalog is fetched from the provider API.'),
        field('providers.' + pid + '.manualModel', 'Manual model id', { placeholder: 'provider/model-id', hint: 'Used when the model mode is manual.' }),
        field('providers.' + pid + '.fallbackModel', 'Fallback model', { placeholder: 'optional' }),
        select('providers.' + pid + '.keyStrategy', 'Key strategy', [['rotate', 'Automatic rotation'], ['manual', 'Manual selection']]),
        (() => {
          const keys = keyStore.pool(pid);
          const s = h('select', {}, [h('option', { value: '', text: 'None (use rotation)' })].concat(keys.map((k) => h('option', { value: k.id, text: k.label + ' \u00B7 ' + maskSecret(k.secret) }))));
          s.value = cfg.selectedKeyId;
          s.addEventListener('change', () => { setPath('providers.' + pid + '.selectedKeyId', s.value); changed(); });
          return row('Pinned key', s, 'Tried first; rotation continues to other keys on rate limits.');
        })(),
        slider('providers.' + pid + '.temperature', 'Temperature', 0, 2, 0.1, (v) => String(v)),
        slider('providers.' + pid + '.maxTokens', 'Maximum output tokens', 128, 8192, 64, (v) => v + ' tokens'),
        slider('providers.' + pid + '.timeoutSec', 'Request timeout', 5, 300, 5, (v) => v + ' s'));

      const t = S.test[pid];
      card.append(h('div', { class: 'btns mt' },
        btn('Test connection', () => testProvider(pid), 'primary'),
        btn('Test first key end to end', () => testKey(pid, keyStore.pool(pid)[0] ? keyStore.pool(pid)[0].id : '')),
        btn('Reset provider settings', () => { if (confirm('Reset ' + ad.label + ' settings? Keys are kept.')) resetProvider(pid); }, 'danger')));
      if (t) card.append(h('div', {}, h('small', { class: 'v ' + (t.status === 'ok' ? 'ok' : t.status === 'fail' ? 'bad' : 'warn'), text: t.msg })));
      return card;
    }

    function viewProviders() {
      // The description provider owns the key pool shown below, so the two
      // always agree. A blank provider is not an error, it just has no pool.
      const vpid = settings.vision.provider || settings.caption.provider || 'huggingface';
      const vmeta = PROVIDER_META[vpid] || PROVIDER_META.huggingface;
      const capKeys = keyStore.pool(vpid);
      const capKeyIn = h('input', { type: 'password', placeholder: 'Paste an API key or token', autocomplete: 'off' });
      const capMsg = h('small', { class: 'muted', text: vmeta.keyHint });
      return h('div', { class: 'stack' },
        h('div', { class: 'card' }, h('b', { text: 'Providers' }),
          h('small', { class: 'muted', text: 'OpenRouter, Groq and Google AI Studio answer questions. Each provider keeps its own key pool; keys are masked, stored locally and never included in exported settings or logs. The configured model is used as-is: if it is unavailable you get the exact provider error instead of a silent substitution.' })),
        PROVIDER_IDS.map(providerCard),
        h('div', { class: 'card' }, h('b', { text: 'Image understanding' }),
          h('small', { class: 'muted', text: 'A picture goes straight to the answering model when that model can see images. A separate description is only made when it cannot, when you press "Describe Image", or when the models failed to answer. Nothing is described just because an image happens to be present.' }),
          sw('vision.enabled', 'Enable image understanding'),
          sw('vision.sendImages', 'Send the picture to models that support it'),
          sw('vision.preferDirect', 'Prefer sending the picture over describing it', 'Keeps it to one request per question. Turn off to always describe the image first and ask in text.'),
          sw('vision.requireModelSupport', 'Only send pictures to models with confirmed vision support', 'Off sends them anyway and reports whatever the provider says.'),
          slider('vision.maxImages', 'Maximum pictures sent to a vision model', 1, LIMITS.imagesMax, 1, (v) => String(v)),
          h('div', { class: 'k mt', text: 'Separate description' }),
          sw('vision.captionEnabled', 'Allow a separate description request'),
          sw('vision.autoCaption', 'Describe before asking when the answering model cannot see', 'Off keeps the extra request for the two on-demand triggers only, which is the cheaper default.'),
          providerSelect('Description provider', 'vision.provider', 'vision.model',
            () => { refreshModels(getPath('vision.provider'), false); ui.rerender(); }),
          field('vision.model', 'Description model', { placeholder: 'model id', hint: 'Any vision-capable model the provider actually serves. OpenRouter and Hugging Face publish per-model input modalities; Groq does not, so pick a multimodal model there.' }),
          providerSelect('Fallback provider', 'caption.fallbackProvider', 'caption.fallbackModel', () => ui.rerender()),
          field('caption.fallbackModel', 'Fallback model', { placeholder: 'optional', hint: 'Used when the description provider fails in a way that can be retried: timeout, rate limit, quota or server error.' }),
          slider('caption.maxImages', 'Maximum pictures described', 1, LIMITS.imagesMax, 1, (v) => String(v)),
          slider('caption.maxDimension', 'Maximum image edge (px)', 256, 2048, 64, (v) => v + ' px'),
          slider('caption.quality', 'JPEG quality', 0.3, 1, 0.05, (v) => Math.round(v * 100) + '%'),
          slider('caption.timeoutSec', 'Description timeout', 5, 300, 5, (v) => v + ' s'),
          h('div', { class: 'k mt', text: 'Wayground-only capture' }),
          sw('vision.captureEnabled', 'Allow capturing the question when the page exposes no image file', 'Never automatic. It only runs from a button you press, and only for this tab.'),
          slider('vision.captureMaxDimension', 'Maximum captured edge (px)', 320, 2048, 64, (v) => v + ' px'),
          h('small', { class: 'muted', text: 'Order of preference: the image file already on the page, then painting just the question element, then a tab-restricted screen surface. The rest of your desktop is never captured, and a browser that cannot prove it is capturing only this tab is refused.' }),
          h('div', { class: 'k mt', text: vmeta.label + ' keys' }),
          keyList(vpid),
          row('Add key', capKeyIn),
          capMsg,
          h('div', { class: 'btns mt' },
            btn('Add and validate', () => {
              const res = commitNewKey(vpid, capKeyIn.value.trim());
              if (!res.ok) { capMsg.textContent = res.error; return; }
              capKeyIn.value = '';
              capMsg.textContent = 'Validating\u2026';
              validateKey(vpid, res.key.id, true).then((r) => {
                capMsg.textContent = r ? (keyStatusLabel(r.status) + (r.httpStatus ? ' (HTTP ' + r.httpStatus + ')' : '') + (r.statusText ? ' \u00B7 ' + r.statusText : '')) : 'Validation did not finish.';
                ui.rerender();
              });
            }, 'primary'),
            btn('Validate all keys', () => {
              if (!capKeys.length) { capMsg.textContent = 'No keys to validate.'; return; }
              capMsg.textContent = 'Checking\u2026';
              Promise.all(capKeys.map((k) => validateKey(vpid, k.id, true))).then(() => ui.rerender());
            }),
            btn('Refresh model list', () => { refreshModels(vpid, true).then((r) => { capMsg.textContent = r.ok ? 'Catalog updated (' + r.count + ' models).' : (r.message || 'Could not refresh.'); ui.rerender(); }); }))),
        btn('Reset all provider settings', () => { if (confirm('Reset every provider setting? Keys are kept.')) PROVIDER_IDS.forEach(resetProvider); }, 'danger'));
    }

    function resetProvider(pid) {
      settings.providers[pid] = JSON.parse(JSON.stringify(DEFAULTS.providers[pid]));
      settings = validateSettings(settings);
      saveSettings();
      modelStore[pid] = validateModelStore(null)[pid];
      saveModels();
      S.prov[pid] = {};
      S.test[pid] = null;
      ui.rerender();
    }

    /* ---------- verification ---------- */
    function viewVerification() {
      const v = settings.verification;
      const models = v.models;
      const list = h('div', { class: 'stack' });
      models.forEach((m, i) => {
        const pid = m.provider;
        const provSel = h('select', {}, PROVIDER_IDS.map((p) => h('option', { value: p, text: PROVIDER_META[p].label })));
        provSel.value = pid;
        provSel.addEventListener('change', () => { models[i].provider = provSel.value; models[i].model = ''; changed(() => ui.rerender()); });
        const ids = modelStore[pid].ids.slice(0, 400);
        const mSel = h('select', {}, [h('option', { value: '', text: 'Automatic (provider default)' })].concat(ids.map((id) => h('option', { value: id, text: id }))));
        mSel.value = m.model;
        mSel.addEventListener('change', () => { models[i].model = mSel.value; changed(() => ui.rerender()); });
        list.append(h('div', { class: 'card' },
          h('div', { class: 'row' }, h('b', { text: 'Model ' + (i + 1) }), btn('Remove', () => { models.splice(i, 1); changed(() => ui.rerender()); }, 'danger')),
          row('Provider', provSel),
          row('Model', mSel),
          h('small', { class: 'muted', text: 'Vision support: ' + (modelSupportsVision(pid, m.model || (modelPlan(pid).plan[0] || ''), catalogEntry(pid, m.model || (modelPlan(pid).plan[0] || '')), null) ? 'yes' : 'not confirmed') })));
      });
      return h('div', { class: 'stack' },
        h('div', { class: 'card' }, h('b', { text: 'Multi-model verification' }),
          sw('verification.enabled', 'Use verification mode', 'Off = each enabled provider answers once and the best answer is shown.'),
          slider('verification.threshold', 'Required agreeing models', 1, 4, 1, (v2) => String(v2)),
          sw('verification.showConflicts', 'Show conflicting answers'),
          sw('verification.history', 'Save verification history'),
          h('small', { class: 'muted', text: 'States: Verified (threshold met), Unverified (usable answer, threshold not met), Conflicting (models answered differently), Failed (no usable answer). Agreement is consistency, not proof of correctness.' })),
        list,
        btn('Add model', () => {
          if (models.length >= 4) return;
          models.push({ provider: 'gemini', model: '' });
          changed(() => ui.rerender());
        }),
        h('div', { class: 'card' }, h('b', { text: 'Verification history' }),
          S.history.length ? S.history.slice(0, 30).map((e) => h('div', { class: 'bd-row' },
            h('div', { class: 'bd-main' }, h('b', { text: trunc(e.question, 60) }), h('small', { class: 'muted', text: new Date(e.ts).toLocaleString() })),
            chip(e.state === 'verified' ? 'vote' : e.state === 'failed' ? 'fail' : 'abstain', VERIFICATION_LABELS[e.state] || e.state),
            h('small', { class: 'muted', text: (e.top || 'no answer') + ' \u00B7 ' + (e.topCount || 0) + ' vote(s)' })))
            : h('small', { class: 'muted', text: 'No verification history yet.' })));
    }

    /* ---------- automation ---------- */
    function viewAutomation() {
      const d = S.detect;
      return h('div', { class: 'stack' },
        h('div', { class: 'card' }, h('b', { text: 'Master control' }),
          sw('automation.masterEnabled', 'Automated actions enabled', 'Turning this off stops automatic analysis and automatic answer selection.'),
          sw('enabled', 'Assistant enabled', 'The panel is hidden when this is off.')),
        h('div', { class: 'card' }, h('b', { text: 'Detection' }),
          sw('automation.autoDetect', 'Automatic question detection'),
          sw('automation.autoAnalyze', 'Analyze automatically when a new question appears'),
          slider('automation.debounceMs', 'Detection debounce', 100, 5000, 100, (v) => v + ' ms'),
          slider('automation.detectTimeoutMs', 'Detection wait timeout', 1000, 60000, 500, (v) => Math.round(v / 1000) + ' s'),
          sw('automation.failoverToOtherProvider', 'Allow failover to another provider', 'Only used when a provider cannot answer at all.'),
          kv([['Status', d.ok ? 'Question detected' : (d.status || 'idle')], ['Strategy', d.strategy || '\u2013'], ['Reason', d.reason || 'none']])),
        h('div', { class: 'card' }, h('b', { text: 'Automatic answer selection (optional)' }),
          h('small', { class: 'muted', text: 'Off by default. Use only in environments where you are allowed to automate answers. The assistant never clicks when the option mapping is ambiguous.' }),
          sw('automation.autoSelect', 'Enable automatic answer selection'),
          sw('automation.confirmSelect', 'Require confirmation before acting'),
          select('automation.clickThreshold', 'Minimum confidence to click', [['low', 'Low'], ['medium', 'Medium'], ['high', 'High']], () => ui.rerender()),
          slider('automation.matchThreshold', 'Minimum text match (0.5 - 1)', 0.5, 1, 0.05, (v) => v.toFixed(2), () => ui.rerender()),
          h('div', { class: 'btns mt' }, btn('EMERGENCY STOP', () => { autoSelect.stop('stopped by the user'); }, 'danger')),
          S.lastSelection ? kv([['Last action', S.lastSelection.state], ['Option', S.lastSelection.letter || '\u2013'], ['Reason', S.lastSelection.reason || '\u2013']]) : null));
    }

    /* ---------- look ---------- */
    function viewAppearance() {
      const ap = settings.appearance;
      const currImg = ap.bgImage && typeof ap.bgImage === 'string' ? ap.bgImage.trim() : '';

      const previewEl = h('div', { class: 'bg-preview' + (currImg ? ' has-img' : '') });
      if (currImg) previewEl.style.backgroundImage = 'url(' + JSON.stringify(currImg) + ')';
      else previewEl.append(h('span', { text: 'No background image \u00B7 the Wayground paper is used' }));

      const urlInput = h('input', { type: 'text', placeholder: 'https://example.com/wallpaper.jpg', value: currImg, 'aria-label': 'Background image URL' });
      const urlStatus = h('p', { class: 'note', text: 'Accepts an https://, http:// or data:image URL. Nothing is uploaded anywhere.' });

      const setStatus = (tone, text) => { urlStatus.className = 'note ' + tone; urlStatus.textContent = text; };
      const applyBg = () => {
        const val = urlInput.value.trim();
        if (!val) { setStatus('warn', 'Enter an image URL first.'); return; }
        // Only http(s) and data:image are allowed: no javascript: or file: URLs.
        if (!/^(https?:\/\/|data:image\/)/i.test(val)) { setStatus('bad', 'That is not an http(s) or data:image URL.'); return; }
        setStatus('', 'Loading the image\u2026');
        const testImg = new Image();
        testImg.onload = () => {
          setPath('appearance.bgImage', val);
          changed();
          previewEl.style.backgroundImage = 'url(' + JSON.stringify(val) + ')';
          previewEl.classList.add('has-img');
          previewEl.replaceChildren();
          setStatus('ok', 'Background applied. Controls keep their own surface, so text stays readable.');
        };
        testImg.onerror = () => setStatus('bad', 'That image could not be loaded. The default appearance is kept.');
        testImg.src = val;
      };
      urlInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); applyBg(); } });

      const resetBg = () => {
        setPath('appearance.bgImage', '');
        setPath('appearance.bgOpacity', DEFAULTS.appearance.bgOpacity);
        setPath('appearance.bgBlur', 0);
        setPath('appearance.bgOverlay', DEFAULTS.appearance.bgOverlay);
        changed();
        urlInput.value = '';
        previewEl.style.backgroundImage = 'none';
        previewEl.classList.remove('has-img');
        previewEl.replaceChildren(h('span', { text: 'No background image \u00B7 the Wayground paper is used' }));
        setStatus('', 'Default appearance restored.');
        ui.rerender();
      };

      // Wayground's own palette, straight from the site's colour tokens.
      const swatches = [
        ['#FF319F', 'Magenta'], ['#FF7925', 'Orange'], ['#3C40B7', 'Indigo'],
        ['#35BBB0', 'Aqua'], ['#A685E0', 'Lavender'], ['#AD106B', 'Deep rose']
      ];
      const swatchRow = h('div', { class: 'chips' }, swatches.map(([c, name]) => h('button', {
        type: 'button', class: 'chip', title: name, 'aria-label': 'Accent ' + name,
        style: 'cursor:pointer;background:' + c + ';color:' + readableOn(c) + ';border-color:transparent;font-weight:700',
        onclick: () => { setPath('appearance.accent', c); changed(); ui.rerender(); }
      }, name)));

      return h('div', { class: 'stack' },
        h('div', { class: 'card' }, h('b', { text: 'Theme' }),
          h('small', { class: 'muted', text: 'Oat is the Wayground light surface, Blackberry is its dark one. A custom accent changes only the accent; the brand paper, ink and state colours stay.' }),
          select('appearance.theme', 'Theme', [['light', 'Oat (light)'], ['dark', 'Blackberry (dark)'], ['system', 'Follow the system']]),
          row('Accent', swatchRow),
          colorInput('appearance.accent', 'Custom accent colour'),
          slider('appearance.opacity', 'Surface opacity', 0.55, 1, 0.01, (v) => Math.round(v * 100) + '%'),
          slider('appearance.fontSize', 'Text size', 11, 18, 1, (v) => v + ' px'),
          sw('appearance.compact', 'Compact density', 'Tighter spacing for a smaller panel.')),

        h('div', { class: 'card' }, h('b', { text: 'Background image' }),
          previewEl,
          row('Image URL', urlInput),
          urlStatus,
          h('div', { class: 'btns' }, btn('Apply', applyBg, 'primary'), btn('Reset to default', resetBg, 'ghost')),
          slider('appearance.bgOpacity', 'Image opacity', 0, 1, 0.05, (v) => Math.round(v * 100) + '%'),
          slider('appearance.bgBlur', 'Image blur', 0, 30, 1, (v) => v + ' px'),
          slider('appearance.bgOverlay', 'Readable overlay', 0.3, 1, 0.05, (v) => Math.round(v * 100) + '%')),

        h('div', { class: 'card' }, h('b', { text: 'Panel size and position' }),
          slider('appearance.scale', 'Interface scale', 0.8, 1.3, 0.05, (v) => Math.round(v * 100) + '%'),
          slider('appearance.panelW', 'Panel width', 300, 560, 10, (v) => v + ' px'),
          slider('appearance.panelH', 'Panel height', 340, 760, 10, (v) => v + ' px'),
          select('appearance.position', 'Default corner', [['right', 'Right'], ['left', 'Left'], ['center', 'Center']]),
          h('small', { class: 'muted', text: 'Drag the header to move the panel. Alt plus arrow keys move it once the header has focus.' }),
          h('div', { class: 'btns mt' }, btn('Reset position', () => {
            setPath('appearance.panelX', -1);
            setPath('appearance.panelY', 72);
            changed();
          }, 'ghost'))),

        h('div', { class: 'card' }, h('b', { text: 'Motion' }),
          sw('appearance.animations', 'Animations', 'Off removes every transition.'),
          sw('appearance.reducedMotion', 'Respect the system reduced-motion setting')),

        h('div', { class: 'card' }, h('b', { text: 'Reset appearance' }),
          h('small', { class: 'muted', text: 'Restores the default theme, colours, size and background. Keys, providers and history are untouched.' }),
          h('div', { class: 'btns mt' },
            btn('Reset appearance', () => {
              settings.appearance = JSON.parse(JSON.stringify(DEFAULTS.appearance));
              settings = validateSettings(settings);
              saveSettings();
              applyAppearance();
              layout();
              ui.rerender();
            }, 'danger'))));
    }

    /* ---------- advanced ---------- */
    function exportSettings() {
      const payload = { __wsa: 4, exportedAt: new Date().toISOString(), settings: exportableSettings(settings) };
      const text = JSON.stringify(payload, null, 2);
      try {
        const blob = new Blob([text], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'wayground-bypass-settings.json';
        document.body.append(a);
        a.click();
        a.remove();
        later(() => URL.revokeObjectURL(url), 2000);
        log('info', 'settings exported (API keys are never included)');
      } catch (e) {
        log('warn', 'settings export failed: ' + (e && e.message));
      }
    }

    function importSettings(file) {
      const fr = new FileReader();
      fr.onload = () => {
        let parsed = null;
        try { parsed = JSON.parse(String(fr.result || '')); } catch (e) { parsed = null; }
        const res = importableSettings(parsed);
        if (!res.ok) { log('warn', 'settings import rejected: ' + res.error); ui.rerender(); return; }
        settings = res.settings;
        saveSettings();
        applyAppearance();
        layout();
        log('info', 'settings imported');
        ui.rerender();
      };
      fr.onerror = () => log('warn', 'settings import failed: the file could not be read');
      fr.readAsText(file);
    }

    function viewAdvanced() {
      const fileIn = h('input', { type: 'file', accept: 'application/json,.json' });
      fileIn.addEventListener('change', () => { if (fileIn.files && fileIn.files[0]) importSettings(fileIn.files[0]); });
      return h('div', { class: 'stack' },
        h('div', { class: 'card' }, h('b', { text: 'Requests' }),
          slider('request.timeoutSec', 'Default timeout', 5, 300, 5, (v) => v + ' s'),
          slider('request.maxRetries', 'Retries per key', 0, 6, 1, (v) => String(v)),
          slider('request.backoffBaseMs', 'Backoff base', 100, 10000, 100, (v) => v + ' ms'),
          slider('request.backoffMaxMs', 'Backoff maximum', 1000, 60000, 500, (v) => v + ' ms'),
          slider('request.cooldownSec', 'Key cooldown after a rate limit', 5, 3600, 5, (v) => v + ' s'),
          sw('request.jitter', 'Randomise backoff (jitter)'),
          sw('request.explain', 'Ask the model for a brief reasoning'),
          sw('request.cacheEnabled', 'Cache repeated questions'),
          slider('request.cacheTtlMin', 'Cache lifetime', 1, 1440, 5, (v) => v + ' min')),
        h('div', { class: 'card' }, h('b', { text: 'Detection overrides' }),
          field('advanced.customQuestionSelector', 'Question selector', { placeholder: 'optional CSS selector' }),
          field('advanced.customChoiceSelector', 'Option selector', { placeholder: 'optional CSS selector' }),
          h('small', { class: 'muted', text: 'Custom selectors are tried first. If the site markup changes, set a selector here to restore detection.' })),
        h('div', { class: 'card' }, h('b', { text: 'Credential safety' }),
          h('small', { class: 'muted', text: 'Keys are stored in your browser by the userscript manager, in plain text, and are masked in this interface. Masking hides them from the screen; it is not encryption. Anyone with access to this browser profile or the Tampermonkey storage can read them.' }),
          sw('security.guardDocumentationPages', 'Block automatic credential storage on documentation pages', 'Applies to paths such as /docs and /provider. Typing a key into this settings panel always works.'),
          sw('security.confirmCrossProviderKeys', 'Ask before saving a key that belongs to another provider', 'A key saved under the wrong provider is sent to that provider on every request.'),
          sw('security.rejectPlaceholders', 'Refuse keys that look like documentation placeholders', 'Turn off only if your real key happens to contain a word such as "test" or "key"; the structural checks still apply.'),
          field('security.docPathSegments', 'Extra path segments to treat as documentation', { placeholder: 'e.g. handbook, api-keys', hint: 'Matched as a whole URL path segment, case-insensitive. Separate with commas or spaces.' }),
          h('div', { class: 'mt' }, h('small', { class: 'muted', text: credentialContextLine() }))),
        h('div', { class: 'card' }, h('b', { text: 'Diagnostics' }),
          sw('diagnostics.logging', 'Verbose logging'),
          select('diagnostics.logLevel', 'Log level', [['error', 'Errors only'], ['info', 'Info'], ['debug', 'Debug']]),
          sw('diagnostics.history', 'Save history locally')),
        h('div', { class: 'card' }, h('b', { text: 'Settings backup' }),
          h('small', { class: 'muted', text: 'Exported files never contain API keys.' }),
          h('div', { class: 'btns mt' }, btn('Export settings', exportSettings, 'primary'), btn('Import settings', () => fileIn.click()), fileIn),
          h('div', { class: 'btns mt' }, btn('Reset everything', () => {
            if (!confirm('Reset all settings to defaults? API keys and history are kept.')) return;
            settings = validateSettings(null);
            settings.acknowledged = false;
            flushSettings();
            applyAppearance();
            layout();
            ui.rerender();
          }, 'danger'))));
    }

    // One honest line about what the guard currently believes about this page.
    function credentialContextLine() {
      const ctx = pageSecurityContext();
      if (!ctx.guardEnabled) return 'Page guard: switched off, so credential storage is allowed anywhere.';
      if (!ctx.documentation) return 'Page guard: this page (' + (ctx.path || ctx.host) + ') is not a documentation path, so keys may be saved here.';
      return 'Page guard: this page looks like documentation (matched ' + ctx.matched.join(', ') + '), so only manual entry in this panel can change stored keys.';
    }

    /* ---------- diagnostics ---------- */
    function renderLog() {
      if (refs.log) refs.log.textContent = logs.length ? logs.slice(-60).map((l) => new Date(l.t).toLocaleTimeString() + ' [' + l.level + '] ' + l.msg).join('\n') : 'Log is empty.';
    }

    function diagnosticReport() {
      const d = S.detect;
      const lines = [];
      lines.push('Wayground.Bypass ' + VERSION + ' \u2014 diagnostic report');
      lines.push('Generated: ' + new Date().toISOString());
      const ctx = pageSecurityContext();
      lines.push('Page: ' + location.href.split('?')[0]);
      lines.push('Credential guard: ' + (ctx.guardEnabled ? 'on' : 'off') + ' | documentation path: ' + (ctx.documentation ? 'yes (' + ctx.matched.join(', ') + ')' : 'no'));
      lines.push('');
      lines.push('Detection: ' + (d.ok ? 'ok' : d.status) + ' | strategy: ' + (d.strategy || '\u2013') + ' | reason: ' + (d.reason || 'none'));
      lines.push('Options found: ' + d.choices.length + ' | images: ' + (d.images || []).length);
      if (d.diag && d.diag.strategies) {
        lines.push('Strategies:');
        for (const s of d.diag.strategies) lines.push('  - ' + s.strategy + ': matched ' + s.matched + ', usable ' + (s.usable != null ? s.usable : s.grouped));
        if (d.diag.missing && d.diag.missing.length) lines.push('Missing: ' + d.diag.missing.join(', '));
      }
      lines.push('');
      lines.push('Providers:');
      for (const pid of PROVIDER_IDS) {
        const st = keyStore.status(pid);
        lines.push('  - ' + PROVIDER_META[pid].label + ': ' + st.label + ' | model ' + (modelPlan(pid).plan[0] || '\u2013') + ' | ' + (modelStore[pid].fetchedAt ? 'catalog checked ' + ago(modelStore[pid].verifiedAt) : 'catalog not fetched'));
        for (const k of keyStore.pool(pid)) {
          lines.push('      * ' + k.label + ' [' + maskSecret(k.secret) + '] ' + (k.enabled ? 'enabled' : 'disabled') + (k.invalid ? ', rejected' : '') + (k.cooldownUntil > nowMs() ? ', cooling down' : ''));
        }
      }
      lines.push('');
      lines.push('Last log entries:');
      for (const l of logs.slice(-80)) lines.push('  ' + new Date(l.t).toISOString() + ' [' + l.level + '] ' + l.msg);
      return lines.join('\n');
    }

    // Read-only inspector: what was extracted, what was sent, what came back.
    function viewInspector() {
      const a = S.app;
      const d = S.detect;
      const runtime = S.detectRuntime;
      const images = (runtime && runtime.images) || d.images || [];
      const wrap = h('div', { class: 'stack' });

      wrap.append(h('div', { class: 'card' }, h('b', { text: 'State' }),
        kv([
          ['Application state', a.state],
          ['Session state', a.sessionState],
          ['Detection confidence', a.detectConfidence ? Math.round(a.detectConfidence * 100) + '%' : '\u2013'],
          ['Reason', a.reason || '\u2013'],
          ['Question detected', a.questionDetected ? 'yes' : 'no'],
          ['Answer choices', String((a.choices || []).length)],
          ['Images on card', String(images.length)],
          ['Relevant images', String(images.filter(isRelevantImage).length)],
          ['Dictation', S.dictation.status === 'idle' ? 'not requested'
            : S.dictation.status + ' (' + (S.dictation.trigger === 'recovery' ? 'answer recovery' : 'manual button') +
              (S.dictation.provider ? ', ' + (PROVIDER_META[S.dictation.provider] ? PROVIDER_META[S.dictation.provider].label : S.dictation.provider) + ' / ' + S.dictation.model : '') + ')'],
          ['Answer mode', S.analysis.mode === 'verification' ? 'verification (' + settings.verification.threshold + ' agreeing)' : 'single model'],
          ['Provider', a.provider ? (PROVIDER_META[a.provider] ? PROVIDER_META[a.provider].label : a.provider) : '\u2013'],
          ['Model', a.model || '\u2013'],
          ['Request status', a.status || 'idle'],
          ['Duration', a.durationMs ? a.durationMs + ' ms' : '\u2013'],
          ['Error', a.error ? trunc(a.error, 160) : 'none']
        ]),
        h('div', { class: 'btns mt' },
          btn('Refresh detection', () => { scanNow(); renderTab(); }),
          btn('Re-run analysis', () => { runAnalysis(true); }))));

      const question = a.question || d.question || '';
      wrap.append(h('div', { class: 'card' }, h('b', { text: 'Current question' }),
        question ? h('p', { class: 'prompt', text: question }) : h('p', { class: 'muted', text: 'No question is active right now.' }),
        images.length
          ? h('div', {}, images.map((im) => h('div', { class: 'bd-row' },
            h('div', { class: 'bd-main' },
              h('small', { class: 'muted', text: describeImageRole(im.role, im.optionIndex) }),
              im.src ? h('img', { src: im.src, alt: im.alt || 'question image', style: 'max-width:120px;max-height:90px;border-radius:8px' }) : null,
              h('small', { class: 'muted', text: im.caption ? 'caption: ' + im.caption : (im.captionError ? 'caption failed: ' + im.captionError : (im.available === false ? 'image not available' : 'caption not requested')) })))))
          : h('p', { class: 'muted', text: 'No relevant image was detected in this question.' })));

      const pp = S.pipe;
      if (pp.startedAt) {
        const rows = PIPE_STAGES.map((k) => [PIPE_LABELS[k], pp.stages[k].state + (pp.stages[k].ms ? ' (' + pp.stages[k].ms + ' ms)' : '') + (pp.stages[k].detail ? ' ' + pp.stages[k].detail : '')]);
        wrap.append(h('div', { class: 'card' }, h('b', { text: 'Image pipeline' }),
          kv([
            ['Route', pp.route || '\u2013'],
            ['Source', pp.captureMethod && pp.captureMethod !== 'none' ? pp.captureMethod : '\u2013'],
            ['Provider', pp.provider ? (PROVIDER_META[pp.provider] ? PROVIDER_META[pp.provider].label : pp.provider) + ' \u00B7 ' + (pp.model || '\u2013') : '\u2013'],
            ['Total', pp.endedAt ? (pp.endedAt - pp.startedAt) + ' ms' : 'running\u2026'],
            ['Error', pp.error ? pp.error.message : 'none']
          ]),
          h('div', { class: 'tw' }, h('table', {}, h('tbody', {}, rows.map((r) => h('tr', {}, h('td', { text: r[0] }), h('td', { text: r[1] })))))),
          pp.caption ? h('p', { class: 'prompt', text: pp.caption }) : null));
      }
      const choices = a.choices && a.choices.length ? a.choices : (d.choices || []);
      const cEls = (S.detectRuntime && S.detectRuntime.cEls) || [];
      // What each option element actually contained, next to what was kept.
      // When a label comes out wrong this is the only way to see whether the
      // page put extra text inside the option or the extractor removed too much.
      const rawOptions = cEls.map((el, i) => 'option ' + labelFor(i) + ' <' + String(el.tagName || '?').toLowerCase() +
        (typeof el.className === 'string' && el.className ? ' class="' + trunc(el.className, 40) + '"' : '') + '> raw="' +
        trunc(normText(el.innerText || el.textContent || ''), 90) + '" kept="' + trunc(choices[i] || '', 60) + '"');
      const rawBox = rawOptions.length
        ? h('details', { class: 'h mt' }, h('summary', { text: 'What the page actually contained' }),
          h('pre', { class: 'log', text: rawOptions.join(String.fromCharCode(10)) }))
        : null;
      wrap.append(h('div', { class: 'card' }, h('b', { text: 'Answer choices' }),
        choices.length
          ? h('ol', { class: 'ev' }, choices.map((t) => h('li', { text: t })))
          : h('p', { class: 'muted', text: 'No answer choices were detected. This question may be open-ended or still rendering.' }),
        rawBox));

      wrap.append(h('div', { class: 'card' }, h('b', { text: 'AI request' }),
        kv([
          ['Provider', a.provider ? (PROVIDER_META[a.provider] ? PROVIDER_META[a.provider].label : a.provider) : '\u2013'],
          ['Model', a.model || '\u2013'],
          ['Status', a.status || 'idle'],
          ['Duration', a.durationMs ? a.durationMs + ' ms' : '\u2013']
        ]),
        h('small', { class: 'muted', text: 'Exact prompt sent to the text model:' }),
        a.prompt ? h('pre', { class: 'log prompt', text: a.prompt }) : h('p', { class: 'muted', text: 'No request has been sent yet.' })));

      wrap.append(h('div', { class: 'card' }, h('b', { text: 'AI response' }),
        a.response ? h('pre', { class: 'log response', text: a.response }) : h('p', { class: 'muted', text: 'No response yet.' }),
        a.error ? h('p', { class: 'v bad', text: a.error }) : null,
        S.analysis && S.analysis.error ? h('p', { class: 'v bad', text: S.analysis.error.message }) : null));

      const ans = a.aiAnswer;
      wrap.append(h('div', { class: 'card' }, h('b', { text: 'Answer and selection' }),
        ans
          ? kv([
            ['Answer', (ans.choice || '\u2013') + (ans.text ? ' \u00B7 ' + ans.text : '')],
            ['Confidence', ans.confidence || '\u2013'],
            ['Belongs to question', ans.sig === a.questionId ? 'yes' : 'no (stale)'],
            ['Match', a.match ? (a.match.ok ? a.match.method + ' (index ' + a.match.index + ')' : 'refused: ' + a.match.reason) : 'not matched yet'],
            ['Selection', a.selection ? a.selection.state : 'none']
          ])
          : h('p', { class: 'muted', text: 'No answer is bound to the current question.' })));

      return wrap;
    }

    function viewDiagnostics() {
      refs = { log: h('pre', { class: 'log' }) };
      const d = S.detect;
      const wrap = h('div', { class: 'stack' });
      wrap.append(h('div', { class: 'card' }, h('b', { text: 'Detection' }),
        kv([['Status', d.ok ? 'ok' : d.status], ['Strategy', d.strategy || '\u2013'], ['Options', String(d.choices.length)], ['Images', String((d.images || []).length)], ['Reason', d.reason || 'none']]),
        h('div', { class: 'btns' }, btn('Detect from page', scanNow), btn('Copy diagnostic report', () => {
          const text = diagnosticReport();
          try { navigator.clipboard.writeText(text); } catch (e) { /* ignore */ }
        }), btn('Export diagnostics (JSON)', () => {
          const payload = {
            report: diagnosticReport(),
            logs: logs.slice(),
            detect: { status: d.status, strategy: d.strategy, reason: d.reason, options: d.choices.length, diag: d.diag }
          };
          try {
            const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url; a.download = 'wsa-diagnostics.json';
            document.body.append(a); a.click(); a.remove();
            later(() => URL.revokeObjectURL(url), 2000);
          } catch (e) { /* ignore */ }
        }))));
      if (d.diag && d.diag.strategies && d.diag.strategies.length) {
        const rows = d.diag.strategies.map((s) => h('tr', {},
          [s.strategy, String(s.matched), String(s.usable != null ? s.usable : s.grouped)].map((t) => h('td', { text: t }))));
        const head = h('tr', {}, ['Strategy', 'Matched', 'Usable'].map((t) => h('th', { text: t })));
        wrap.append(h('div', { class: 'card' }, h('b', { text: 'Strategy trace' }),
          h('div', { class: 'tw' }, h('table', {}, h('thead', {}, head), h('tbody', {}, rows)))));
      }
      const keyRows = KEY_PROVIDER_IDS.map((pid) => {
        const st = keyStore.status(pid);
        const names = keyStore.pool(pid).map((k) => k.label + ' (' + maskSecret(k.secret) + ')').join(', ') || 'no keys';
        return h('div', { class: 'bd-row' },
          h('div', { class: 'bd-main' },
            h('b', { text: PROVIDER_META[pid].label }),
            h('small', { class: 'muted', text: names })),
          chip(st.state === 'ok' ? 'vote' : st.state === 'warn' ? 'abstain' : 'fail', st.label));
      });
      wrap.append(h('div', { class: 'card' }, h('b', { text: 'Providers and keys' }), keyRows));
      // Compact request log: provider, model, duration, HTTP status, sanitized error.
      const bd = (S.analysis && S.analysis.breakdown) || [];
      if (bd.length) {
        const rows = bd.map((x) => h('tr', {}, [
          PROVIDER_META[x.provider] ? PROVIDER_META[x.provider].label : x.provider,
          x.model || '\u2013',
          x.latencyMs != null ? x.latencyMs + ' ms' : '\u2013',
          x.httpStatus ? String(x.httpStatus) : '\u2013',
          x.error ? trunc(x.error, 80) : (x.ok ? 'ok' : '')
        ].map((t) => h('td', { text: String(t) }))));
        const head = h('tr', {}, ['Provider', 'Model', 'Duration', 'HTTP', 'Error'].map((t) => h('th', { text: t })));
        wrap.append(h('div', { class: 'card' }, h('b', { text: 'Last requests' }),
          h('div', { class: 'tw' }, h('table', {}, h('thead', {}, head), h('tbody', {}, rows)))));
      }
      wrap.append(refs.log ? h('div', { class: 'card' }, h('b', { text: 'Log (secrets redacted)' }),
        sw('diagnostics.logging', 'Verbose logging'),
        h('div', { class: 'btns mt' }, btn('Clear log', () => { logs.length = 0; renderLog(); }), btn('Copy log', () => {
          try { navigator.clipboard.writeText(logs.map((l) => new Date(l.t).toISOString() + ' ' + l.level + ' ' + l.msg).join('\n')); } catch (e) { /* ignore */ }
        })),
        refs.log) : null);
      // The About section owns project details and limitations; duplicating them
      // here only made the log page longer.
      later(renderLog, 0);
      return wrap;
    }

    function viewAbout() {
      const wrap = h('div', { class: 'stack' });
      wrap.append(h('div', { class: 'card' },
        h('div', { class: 'row' }, h('label', {}, h('b', { class: 'hand', text: 'Wayground Study Assistant' }), h('small', { class: 'muted', text: 'Version ' + VERSION })), wgMark(30)),
        kv([
          ['Answering', PROVIDER_IDS.map((p) => PROVIDER_META[p].label).join(', ')],
          ['Image description', (settings.vision.provider ? PROVIDER_META[settings.vision.provider].label : 'no provider') + ' \u00B7 ' + (settings.vision.model || 'no model') + (settings.vision.captionEnabled ? '' : ' (disabled)')],
          ['Verification', settings.verification.enabled ? ('on, ' + settings.verification.threshold + ' agreeing') : 'off, single model'],
          ['Storage', 'Settings and keys stay in this browser via Tampermonkey storage.'],
          ['Export', 'Exported settings never contain an API key.']
        ])));
      wrap.append(h('div', { class: 'card' }, h('b', { text: 'What it does not promise' }),
        h('ul', { class: 'ev' },
          h('li', { text: 'Agreement between models is consistency, not proof of correctness.' }),
          h('li', { text: 'Detection uses layered DOM strategies and is not verified against a live Wayground session; the diagnostics trace shows what matched.' }),
          h('li', { text: 'Image dictation runs only on demand: the Describe Image button, or one automatic recovery attempt when nothing could be answered.' }),
          h('li', { text: 'Automatic answer selection is opt-in, never clicks an ambiguous option, and stops immediately on the emergency hotkey Alt+Shift+X.' }))));
      wrap.append(h('div', { class: 'card' }, h('b', { text: 'Brand and identity' }),
        h('p', { text: 'The logotype, the square mark and the colours are taken from the live wayground.com assets. DM Sans and Kalam are the site\u2019s declared typefaces with their published Arial fallback; they are used only if already installed, because no webfont is fetched.' }),
        h('p', { class: 'muted', text: 'Panel geometry and spacing are an approximation of the product UI, which is not reachable without a signed-in session.' })));
      wrap.append(h('div', { class: 'card' }, h('b', { text: 'Documentation' }),
        h('ul', { class: 'ev' }, PROVIDER_IDS.concat(['huggingface']).map((p) => h('li', { text: PROVIDER_META[p].label + ': ' + PROVIDER_META[p].docs })))));
      wrap.append(h('div', { class: 'card' }, h('b', { text: 'Shortcuts' }),
        kv([['Alt + Shift + W', 'Show or hide the assistant'], ['Alt + Shift + X', 'Emergency stop for auto-click'],
          ['Alt + arrow keys', 'Move the panel once it has focus'], ['Enter in a key field', 'Add and validate that key']])));
      return wrap;
    }

    /* ---------- shell: one live panel, one settings screen ---------- */
    // The settings groups replace the old eight-tab rail. Each one is a real
    // feature area, not a placeholder.
    const SETTINGS_VIEWS = {
      ai: () => h('div', { class: 'stack' }, viewTargets(), viewProviders(), viewVerification()),
      behavior: () => viewAutomation(),
      look: () => viewAppearance(),
      advanced: () => h('div', { class: 'stack' }, viewAdvanced(),
        h('details', { class: 'h' }, h('summary', { text: 'Inspector: what was extracted, sent and received' }), viewInspector()),
        h('details', { class: 'h' }, h('summary', { text: 'Diagnostics and log' }), viewDiagnostics())),
      about: () => viewAbout()
    };

    function renderScreen() {
      refs = {};
      const isLive = S.screen === 'live';
      liveEl.dataset.on = isLive ? '1' : '0';
      setEl.dataset.on = isLive ? '0' : '1';
      if (isLive) {
        // Built once. Later updates patch the sub-boxes so that typing in the
        // editor is never interrupted by a re-render.
        liveEl.replaceChildren(screenLive());
        drawChrome();
        return;
      }
      // A view that throws must not leave the settings panel blank: the user
      // would have no way to tell a crash from an empty section.
      let body = null;
      try {
        body = (SETTINGS_VIEWS[S.tab] || SETTINGS_VIEWS.ai)();
      } catch (e) {
        log('error', 'settings section ' + S.tab + ' failed to render: ' + ((e && e.message) || e) +
          ' | ' + String((e && e.stack) || '').split(String.fromCharCode(10)).slice(0, 3).join(' <- '));
        body = h('div', { class: 'card bad' }, h('b', { text: 'This section could not be opened' }),
          h('p', { text: (e && e.message) || 'Unknown error.' }),
          h('small', { class: 'muted', text: 'Your saved settings are untouched. The diagnostics log has the stack.' }),
          h('div', { class: 'btns mt' }, btn('Try again', () => renderScreen(), 'ghost')));
      }
      setBodyEl.replaceChildren(body);
      setNavEl.querySelectorAll('button').forEach((b) => b.setAttribute('aria-current', String(b.dataset.id === S.tab)));
    }
    function setTab(id) { S.tab = id; S.screen = 'settings'; renderScreen(); }
    function setScreen(id) { S.screen = id; renderScreen(); }
    const renderTab = renderScreen;

    function flush() {
      raf = 0;
      if (!win) return;
      drawChrome();
      if (autoBtn) {
        const on = autoSelect.enabled();
        autoBtn.setAttribute('aria-pressed', String(on));
        autoBtn.dataset.on = on ? '1' : '0';
        autoBtn.title = (on ? 'Auto-click on (click to turn off)' : 'Auto-click off (click to turn on)');
      }
      if (S.screen === 'live') {
        if (kinds.has('detect')) syncInputs();
        drawQuestion();
        drawAnswer();
        drawPipeline();
        drawFooter();
      } else if (S.tab === 'advanced' && (kinds.has('analysis') || kinds.has('detect') || kinds.has('state') || kinds.has('test') || kinds.has('history'))) {
        renderScreen();
      } else if (S.tab === 'ai' && kinds.has('models')) {
        renderScreen();
      }
      kinds.clear();
    }
    function refresh(kind) { kinds.add(kind); if (!raf) raf = requestAnimationFrame(flush); }

    function drag(el, onMove, onEnd) {
      el.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        // Never start a drag from an interactive control.
        if (e.target.closest('button') || e.target.closest('input') || e.target.closest('select') ||
            e.target.closest('textarea') || e.target.closest('a') || e.target.closest('label')) return;
        try { el.setPointerCapture(e.pointerId); } catch (err) { /* not supported */ }
        const sx = e.clientX, sy = e.clientY;
        const r = win.getBoundingClientRect();
        let dragging = false;
        const move = (ev) => {
          // A small threshold keeps clicks and text selection working.
          if (!dragging && Math.abs(ev.clientX - sx) + Math.abs(ev.clientY - sy) < 4) return;
          dragging = true;
          onMove(ev.clientX - sx, ev.clientY - sy, r);
        };
        const up = () => {
          el.removeEventListener('pointermove', move);
          el.removeEventListener('pointerup', up);
          el.removeEventListener('pointercancel', up);
          if (dragging) onEnd();
        };
        el.addEventListener('pointermove', move);
        el.addEventListener('pointerup', up);
        el.addEventListener('pointercancel', up);
      });
    }
    function mount() {
      host = h('div', { id: HOST_ID });
      shadow = host.attachShadow({ mode: 'open' });
      dot = h('span', { class: 'dot', 'data-s': 'idle', 'aria-hidden': 'true' });
      statusLabel = h('span', { text: 'Idle' });
      statusEl = h('span', { class: 'status', 'aria-live': 'polite' }, dot, statusLabel);
      brandEl = h('span', { class: 'brand' });
      bar = h('div', { class: 'topbar', tabindex: '0', role: 'toolbar', 'aria-label': 'Assistant header. Alt plus arrow keys move the panel.' },
        brandEl,
        statusEl,
        h('span', { class: 'sp' }),
        autoBtn = h('button', { class: 'ib', type: 'button', 'aria-label': 'Auto-click', 'aria-pressed': 'false', title: 'Auto-click', onclick: () => {
          const next = !getPath('automation.autoSelect');
          setPath('automation.autoSelect', next);
          if (!next) autoSelect.stopped = false;
          changed();
          log('info', 'automatic answer selection ' + (next ? 'enabled' : 'disabled'));
          if (next && S.detect.ok && settings.acknowledged && settings.automation.masterEnabled) runAnalysis(false);
        } }, icon('bolt')),
        h('button', { class: 'ib', type: 'button', 'aria-label': 'Settings', title: 'Settings', onclick: () => {
          if (S.screen === 'settings') setScreen('live'); else setTab(S.tab);
        } }, icon('gear')),
        h('button', { class: 'ib', type: 'button', 'aria-label': 'Minimize', title: 'Minimize', onclick: () => { minimized = true; layout(); } }, icon('minimize')),
        h('button', { class: 'ib', type: 'button', 'aria-label': 'Close the assistant', title: 'Close the assistant', onclick: () => { settings.enabled = false; saveSettings(); applyEnabled(); } }, icon('close')));

      setNavEl = h('nav', { class: 'setnav', role: 'tablist', 'aria-label': 'Settings sections' },
        SETTINGS.map(([id, label]) => h('button', { type: 'button', role: 'tab', 'data-id': id,
          'aria-selected': 'false', 'aria-current': 'false', onclick: () => setTab(id) }, label)));
      setBodyEl = h('div', { class: 'scroller', role: 'tabpanel', tabindex: '0' });
      setEl = h('div', { class: 'screen', 'data-on': '0', 'aria-label': 'Settings' },
        h('div', { class: 'sethead' },
          btn('Panel', () => setScreen('live'), 'ghost', 'back'),
          h('b', { text: 'Settings' })),
        setNavEl, setBodyEl);
      liveEl = h('div', { class: 'screen', 'data-on': '1', role: 'region', 'aria-label': 'Assistant panel' });

      bgLayer = h('div', { class: 'bg-layer' });
      win = h('div', { class: 'win', role: 'dialog', 'aria-label': 'Wayground Study Assistant' },
        bgLayer, h('div', { class: 'scrim' }), bar, liveEl, setEl);
      pill = h('button', { class: 'pill', type: 'button', 'aria-label': 'Restore the assistant panel',
        onclick: () => { minimized = false; layout(); } }, wgMark(34, false));
      let sheeted = false;
      try { const sh = new CSSStyleSheet(); sh.replaceSync(CSS); shadow.adoptedStyleSheets = [sh]; sheeted = true; } catch (e) { /* fall back */ }
      if (!sheeted) shadow.append(h('style', { text: CSS }));
      shadow.append(win, pill);
      document.documentElement.append(host);

      // The whole window can be dragged; interactive controls are excluded.
      drag(win, (dx, dy, r) => {
        setPath('appearance.panelX', r.left + dx);
        setPath('appearance.panelY', r.top + dy);
        layout();
      }, () => { saveSettings(); });
      bar.addEventListener('keydown', (e) => {
        if (!e.altKey) return;
        const m = { ArrowLeft: [-12, 0], ArrowRight: [12, 0], ArrowUp: [0, -12], ArrowDown: [0, 12] }[e.key];
        if (!m) return;
        const r = win.getBoundingClientRect();
        setPath('appearance.panelX', r.left + m[0]);
        setPath('appearance.panelY', r.top + m[1]);
        layout();
        saveSettings();
        e.preventDefault();
      });
      listen(window, 'resize', debounce(layout, 120));
      applyAppearance();
      layout();
      renderScreen();
    }

    function open() {
      if (!host) return;
      host.style.display = '';
      layout();
      applyAppearance();
      requestAnimationFrame(() => win && win.classList.add('is-open'));
    }
    function close() {
      if (!win) return;
      win.classList.remove('is-open');
      later(() => { if (!settings.enabled && host) host.style.display = 'none'; }, 220);
    }
    function unmount() { if (raf) cancelAnimationFrame(raf); if (host) host.remove(); host = win = null; }

    return {
      mount, open, close, unmount, refresh, applyAppearance, layout,
      rerender: () => renderScreen(),
      setScreen, setTab,
      goLive: () => setScreen('live'),
      openSettings: () => setTab(S.tab)
    };
  })();

  let minimized = false;

  /* ==================================================================
   * Provider tests, key tests
   * ================================================================== */
  const trivialRequest = () => buildRequest('Which of these two numbers is larger?', ['2', '9'], '').req;

  async function testProvider(pid) {
    S.test[pid] = { status: 'busy', msg: 'Testing\u2026' };
    ui.refresh('test');
    const plan = modelPlan(pid).plan[0];
    if (!plan) { S.test[pid] = { status: 'fail', msg: 'No model is configured for ' + PROVIDER_META[pid].label + '.' }; ui.refresh('test'); return; }
    const req = trivialRequest();
    const prompt = buildPrompt(req);
    const res = await callProvider(pid, { model: plan, prompt, images: [], cfg: { maxTokens: 200 }, ctl: { cancelled: false, abort() {} } });
    if (res.ok) {
      const obj = parseJsonLoose(res.text);
      const v = obj ? validateAnswer(obj, req) : { ok: false, error: 'not valid JSON' };
      const ms = res.attempts && res.attempts.length ? res.attempts[res.attempts.length - 1].ms : 0;
      S.test[pid] = { status: v.ok ? 'ok' : 'warn', msg: v.ok ? 'Connected: ' + plan + ' answered in ' + ms + ' ms.' : 'Connected, but the test reply was rejected: ' + v.error };
    } else {
      S.test[pid] = { status: 'fail', msg: PROVIDER_META[pid].label + ': ' + res.error.message + (res.error.remediation ? ' ' + res.error.remediation : '') };
    }
    ui.refresh('test');
  }

  async function testKey(pid, keyId) {
    S.test[pid] = { status: 'busy', msg: 'Testing key\u2026' };
    ui.refresh('test');
    const plan = modelPlan(pid).plan[0];
    if (!plan) { S.test[pid] = { status: 'fail', msg: 'No model is configured for ' + PROVIDER_META[pid].label + '.' }; ui.refresh('test'); return; }
    const req = trivialRequest();
    const res = await callProvider(pid, { model: plan, prompt: buildPrompt(req), images: [], cfg: { maxTokens: 200 }, keyId: keyId || undefined, ctl: { cancelled: false, abort() {} } });
    if (res.ok) {
      const used = res.keyLabel;
      S.test[pid] = { status: 'ok', msg: 'Key "' + used + '" works (' + plan + ').' };
    } else {
      S.test[pid] = { status: 'fail', msg: 'Key "' + (keyStore.pool(pid).find((k) => k.id === keyId) || {}).label + '" failed: ' + res.error.message };
    }
    ui.refresh('test');
  }

  /* ==================================================================
   * Provider registry facade (uniform interface over all adapters)
   * ================================================================== */
  const ProviderRegistry = {
    ids: PROVIDER_IDS,
    get(pid) {
      const ad = adapters[pid];
      if (!ad) return null;
      return {
        id: pid,
        label: ad.label,
        async checkAvailability() {
          const r = await refreshModels(pid, true);
          const a = availabilityOf(pid);
          return { available: a.state === 'available' ? true : a.state === 'unavailable' ? false : null, state: a.state, reason: r.ok ? a.reason : (r.message || a.reason) };
        },
        async analyzeQuestion(question, choices, notes) {
          const b = buildRequest(question, choices, notes || '');
          if (!b.ok) return { provider: pid, status: 'error', failure: 'input', message: b.error, latencyMs: 0, model: '' };
          const plan = modelPlan(pid).plan[0];
          if (!plan) return { provider: pid, status: 'error', failure: 'no-model', message: 'No model is configured.', latencyMs: 0, model: '' };
          const res = await callProvider(pid, { model: plan, prompt: buildPrompt(b.req), images: [], cfg: {}, ctl: { cancelled: false, abort() {} } });
          if (!res.ok) return { provider: pid, status: 'error', failure: res.error.code, message: res.error.message, latencyMs: 0, model: plan };
          const obj = parseJsonLoose(res.text);
          const v = obj ? validateAnswer(obj, b.req) : { ok: false, error: 'not valid JSON' };
          if (!v.ok) return { provider: pid, status: 'error', failure: 'invalid-response', message: v.error, latencyMs: 0, model: plan };
          return { provider: pid, status: 'ok', value: v.value, model: plan, latencyMs: res.attempts.length ? res.attempts[res.attempts.length - 1].ms : 0 };
        },
        normalizeResponse(response, req) {
          try {
            const raw = ad.parse(response);
            const obj = parseJsonLoose(raw.text);
            return obj == null ? { ok: false, error: 'not valid JSON' } : validateAnswer(obj, req);
          } catch (e) { return { ok: false, error: (e && (e.message || e.code)) || 'unusable response' }; }
        },
        getStatus: () => keyStore.status(pid),
        getLatency: () => { const sp = S.prov[pid]; return sp && sp.lastLatency != null ? sp.lastLatency : null; }
      };
    }
  };

  /* ==================================================================
   * Lifecycle
   * ================================================================== */
  function applyEnabled() {
    if (settings.enabled) { ui.open(); startDetection(); }
    else { ui.close(); stopDetection(); cancelAnalysis(); clearHighlights(); }
    saveSettings();
  }

  function destroy() {
    stopDetection();
    cancelAnalysis();
    clearHighlights();
    saveSettings.cancel();
    flushSettings();
    saveKeys.cancel();
    flushKeys();
    cleanups.splice(0).forEach((f) => { try { f(); } catch (e) { /* ignore */ } });
    timers.forEach((t) => clearTimeout(t));
    timers.clear();
    ui.unmount();
    removePageCss();
    delete window.__wsa;
  }

  function init() {
    updatePageStyle();
    ui.mount();
    if (settings.enabled) { ui.open(); startDetection(); } else { ui.close(); }

    listen(window, 'popstate', () => { scheduleScan(); });
    listen(window, 'hashchange', () => { scheduleScan(); });
    listen(window, 'keydown', (e) => {
      // Emergency stop for automatic answer selection.
      if (e.altKey && e.shiftKey && (e.code === 'KeyX' || e.key === 'x' || e.key === 'X')) {
        e.preventDefault();
        autoSelect.stop('emergency stop hotkey');
        return;
      }
      if (e.altKey && e.shiftKey && e.code === 'KeyW') {
        e.preventDefault();
        settings.enabled = !settings.enabled;
        applyEnabled();
        ui.refresh('detect');
      }
    });
    listen(window, 'pagehide', () => { flushSettings(); stopDetection(); cancelAnalysis(); });
    listen(window, 'pageshow', (e) => { if (e.persisted) startDetection(); });

    // Single page application navigation support.
    try {
      const push = history.pushState;
      const replace = history.replaceState;
      history.pushState = function () { const r = push.apply(history, arguments); scheduleScan(); return r; };
      history.replaceState = function () { const r = replace.apply(history, arguments); scheduleScan(); return r; };
      cleanups.push(() => { history.pushState = push; history.replaceState = replace; });
    } catch (e) { /* ignore */ }

    try {
      GM_registerMenuCommand('Open Wayground.Bypass', () => { settings.enabled = true; minimized = false; applyEnabled(); ui.layout(); });
      GM_registerMenuCommand('Toggle automatic answer selection', () => { setPath('automation.autoSelect', !getPath('automation.autoSelect')); changed(); });
      GM_registerMenuCommand('Emergency stop (auto-select off)', () => autoSelect.stop('menu command'));
      GM_registerMenuCommand('Reset panel position', () => { setPath('appearance.panelX', -1); setPath('appearance.panelY', 72); saveSettings(); ui.layout(); });
    } catch (e) { /* menu unavailable */ }

    if (settings.enabled) later(() => PROVIDER_IDS.forEach((pid) => { if (settings.providers[pid].enabled) refreshModels(pid, false); }), 1500);

    window.__wsa = {
      destroy, version: VERSION,
      modules: {
        QuestionDetector: { detectNow, scanNow, scan, collectImages },
        ChoiceExtractor: { findChoices, findQuestion, normalizeChoices },
        ProviderRegistry, ProviderAdapters: adapters,
        KeyManager: Object.assign({}, keyStore, { validate: validateKey }),
        ModelStore: { get: (pid) => modelStore[pid], set: (pid, patch) => Object.assign(modelStore[pid], patch) },
        Analysis: { runAnalysis, cancelAnalysis, plannedTargets, pickAnalysisTargets, analysisCacheKey },
        VerificationEngine: { computeVerification, VERIFICATION_LABELS },
        ResponseValidator: { validateAnswer, parseJsonLoose, buildRequest, buildPrompt, buildDictationPrompt, DICTATION_LABELS },
        ImageDictation: { describeImage, shouldAttemptDictation, isRelevantImage, relevantImages, resetDictation, visionPlan, state: () => S.dictation },
        VisionPipeline: { fetchImageData, captionImages, captionOne, shrinkImage, modelSupportsVision, pickImageSource, prepareImages, loadImageBytes, captionCacheClear },
        ImagePipeline: { blankPipeline, pipeSet, pipeSkip, pipeFail, pipeFinish, pipeSummary, resetPipeline, state: () => S.pipe },
        Capture: { captureSupport, rasterizeElement, captureTabFrame, acquireQuestionImage, captureSurfaceOk },
        AutoSelect: autoSelect,
        HighlightManager: { applyHighlight, clearHighlights },
        SettingsManager: { validateSettings, get: () => settings },
        DiagnosticsManager: { logs, redact },
        DashboardUI: ui,
        state: S
      }
    };
    log('info', 'Wayground.Bypass v' + VERSION + ' initialized');
  }

  init();
})();
